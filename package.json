{
  "version": "3.0.2",
  "name": "i18next-locales-sync",
  "description": "Syncs i18next locale resource files against a primary language.\n",
  "keywords": [
    "i18next",
    "locale",
    "sync"
  ],
  "author": "felixmosh",
  "license": "MIT",
  "homepage": "https://github.com/felixmosh/i18next-locales-sync",
  "bugs": "https://github.com/felixmosh/i18next-locales-sync/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/felixmosh/i18next-locales-sync"
  },
  "main": "dist/index.js",
  "bin": "dist/cli.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "lint": "oxlint",
    "format": "oxfmt .",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "release": "release-it --only-version",
    "prepare": "husky"
  },
  "dependencies": {
    "fdir": "^6.5.0",
    "fs-extra": "^11.4.1",
    "picomatch": "^4.0.7",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/yargs": "^17.0.35",
    "auto-changelog": "^2.7.0",
    "husky": "^9.1.7",
    "memfs": "^3.5.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "release-it": "^20.2.1",
    "typescript": "^6.0.3"
  },
  "release-it": {
    "npm": {
      "provenance": true,
      "skipChecks": true,
      "publish": false
    },
    "git": {
      "tagName": "v${version}",
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs"
    },
    "hooks": {
      "before:init": [
        "yarn test",
        "yarn lint",
        "yarn build"
      ],
      "after:bump": "npx auto-changelog -p"
    }
  }
}
